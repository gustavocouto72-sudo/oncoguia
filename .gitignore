# ---- dependências ----
node_modules/

# ---- segredos ----
# Nada de credencial no repositório. O .env.example (versionado) documenta as chaves.
.env
*.env
.env.*
!.env.example

# ---- sessões de navegador (cookies de login vivos) ----
_opensquad/_browser_profile/
.playwright-mcp/

# ---- worktrees do harness (cópias de trabalho, nunca versionadas) ----
.claude/worktrees/

# ---- artefatos de build / cache ----
dist/
build/
.vercel/
.vercel
.cache/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ---- saídas de teste / logs ----
test-results/
playwright-report/
_opensquad/logs/
*.log

# ---- uploads em runtime ----
backend/uploads/

# ---- SO / editor ----
.DS_Store
.idea/
*.swp

# Cache de abstracts da extração de expectativa de uso: ~1,9 MB de texto de abstract de
# editora, regenerável por fetch_abstracts.py. A proveniência versionada é a citação
# pontual de cada número usado, em fontes-extraidas.json.
squads/mbe-oncologia/extracao-expectativa-uso/abstracts.json
squads/mbe-oncologia/extracao-expectativa-uso/candidatos.json

# Screenshot que os portões gravam quando um check de UI falha: artefato de depuração de
# UMA rodada, regenerável, e que um `git add -A` distraído leva junto para o commit.
portao-*-erro.png

# Mockups de tela: são desenhados sobre CASO REAL (prontuário de paciente, com registro,
# datas e série de exames) e não têm anonimização que resista ao contexto da instituição.
# Ficam fora do repositório — a cópia de trabalho vive em ~/Downloads/oncoguia-mockups/.
app/mockups/

# Fontes cruas das ondas de re-derivação do GRADE: respostas de Crossref/Europe PMC/OpenAlex/
# Unpaywall (com abstract) e texto integral de artigos (.html PMC/OA). Texto de editora,
# regenerável pelos abrir_fontes*.py de cada onda — mesma família do cache de abstracts acima.
# O que se versiona é o MANIFESTO.md de cada pasta (DOI, PMCID, título, data, licença), gerado
# por output/<run>/gerar_manifesto_fontes.py.
squads/**/fontes/*
!squads/**/fontes/MANIFESTO.md
