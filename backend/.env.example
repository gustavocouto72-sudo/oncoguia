# ------------------------------------------------------------------------------
# BANCO — em desenvolvimento, SEMPRE o branch de dev. Nunca o principal.
# ------------------------------------------------------------------------------
# Dev e produção compartilhavam o mesmo banco Neon, e todo teste local escrevia na
# base que o auditor enxerga. Agora há um branch "dev" no Neon, e o backend RECUSA
# subir em modo dev se a DATABASE_URL não apontar para ele.
#
# A string de PRODUÇÃO não pode existir em nenhum arquivo local nem versionado —
# ela vive apenas nas env vars do projeto na Vercel.
#
# Placeholder abaixo: substitua pela string do BRANCH DEV, do console do Neon.
DATABASE_URL=postgres://usuario:senha@ep-SEU-BRANCH-DEV-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require

# Endpoint do branch de DEV — a trava anti-engano. É só o identificador do endpoint
# (o começo do host, sem o "-pooler"), não a string inteira: não é credencial.
# O backend em modo dev só sobe, e os portões só rodam, se a DATABASE_URL acima
# apontar para EXATAMENTE este endpoint. É allowlist: sem esta variável nada sobe,
# e qualquer outro banco (produção inclusive) é recusado.
# Copie do console do Neon, do branch de desenvolvimento.
ONCOGUIA_DB_DEV_ENDPOINT=ep-SEU-BRANCH-DEV

# ------------------------------------------------------------------------------
# Resto
# ------------------------------------------------------------------------------
# Segredo do JWT — gere um forte: openssl rand -hex 32
JWT_SECRET=troque_por_secret_forte_em_producao
JWT_EXPIRY=8h
# 3005 é a porta reservada do OncoGuia (3001 é do Hospital Virtual) — ver ~/Antigravity/PORTS.md.
PORT=3005
# Origens liberadas no CORS (separadas por vírgula). Vazio em dev = libera tudo.
CORS_ORIGINS=
